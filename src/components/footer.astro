---
import Container from "@components/container.astro";
import { Icon } from "astro-icon/components";

const { margin } = Astro.props;

const footermenu = {
  company: [
    { title: "About", path: "/about" },
    { title: "Contact", path: "/contact" },
    { title: "Careers", path: "/contact" },
  ],
  services: [
    { title: "Software Platforms", path: "/services#platforms" },
    { title: "System Integration", path: "/services#integration" },
    { title: "AI Agentic Systems", path: "/services#ai-agents" },
  ],
  industries: [
    { title: "IoT Platforms", path: "/industries#iot" },
    { title: "Healthcare Technology", path: "/industries#healthcare" },
    { title: "Enterprise Infrastructure", path: "/industries#enterprise" },
  ],
};
---

<footer
  class:list={[
    "py-14 bg-slate-100 border-t border-slate-100",
    margin && "mt-10",
  ]}>
  <Container>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
      <div class="sm:col-span-2 md:col-span-3 lg:col-span-2">
        <a href="/" class="text-lg flex items-center">
          <span class="font-bold text-[#FF784F]">Tech</span><span class="font-bold text-slate-700">Force</span>
        </a>
        <p class="mt-3 text-sm text-slate-600 max-w-xs">
          Engineering the systems behind intelligent software.
        </p>
      </div>
      <div>
        <h3 class="font-medium text-sm text-slate-800">Company</h3>
        <div class="flex flex-col mt-3">
          {
            footermenu.company.map((item) => (
              <a
                href={item.path}
                class="py-2 text-sm text-slate-600 hover:text-indigo-600">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <h3 class="font-medium text-sm text-slate-800">Services</h3>
        <div class="flex flex-col mt-3">
          {
            footermenu.services.map((item) => (
              <a
                href={item.path}
                class="py-2 text-sm text-slate-600 hover:text-indigo-600">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <h3 class="font-medium text-sm text-slate-800">Industries</h3>
        <div class="flex flex-col mt-3">
          {
            footermenu.industries.map((item) => (
              <a
                href={item.path}
                class="py-2 text-sm text-slate-600 hover:text-indigo-600">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Container>

  <div class="mt-14 pt-8 px-5 border-t border-slate-200">
    <Container>
      <p class="text-center text-sm text-slate-600">
        &copy; 2026 Tech Force O&Uuml;. All rights reserved.
      </p>
      <p class="text-center text-xs text-slate-600 mt-2">
        <a href="/privacy" class="hover:text-indigo-500">Privacy Policy</a> &middot; <a
          href="/terms"
          class="hover:text-indigo-500">Terms of Service</a>
      </p>
    </Container>
  </div>
</footer>
