---
import Container from "@components/container.astro";
---

<Container>
  <div class="mt-24">
    <div class="grid sm:grid-cols-3 gap-8 text-center">
      <div class="bg-slate-50 border border-slate-100 rounded-2xl p-8">
        <div class="text-4xl font-bold text-indigo-600">5+</div>
        <div class="mt-2 text-slate-700 font-medium">Senior engineers</div>
        <div class="mt-1 text-sm text-slate-500">with production-grade experience</div>
      </div>
      <div class="bg-slate-50 border border-slate-100 rounded-2xl p-8">
        <div class="text-4xl font-bold text-indigo-600">3</div>
        <div class="mt-2 text-slate-700 font-medium">Core domains</div>
        <div class="mt-1 text-sm text-slate-500">IoT, Healthcare & Enterprise</div>
      </div>
      <div class="bg-slate-50 border border-slate-100 rounded-2xl p-8">
        <div class="text-4xl font-bold text-indigo-600">100%</div>
        <div class="mt-2 text-slate-700 font-medium">Production-grade</div>
        <div class="mt-1 text-sm text-slate-500">systems built for real load</div>
      </div>
    </div>
  </div>
</Container>
