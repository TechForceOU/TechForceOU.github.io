---
import Link from "./ui/link.astro";
---

<div
  class="bg-gradient-to-bl from-indigo-900 to-indigo-700 p-8 md:px-20 md:py-20 mt-20 flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-5xl tracking-tight">
    Let TechForce be with you.
  </h2>
  <p class="text-white/70 mt-4 text-lg md:text-xl max-w-xl">
    Book a 30-minute discovery call. We'll talk about your requirements, timeline, and how we can help.
  </p>
  <div class="flex mt-5">
    <button type="button" class="rounded-full transition cursor-pointer px-7 py-2.5 bg-white text-indigo-800 border-2 border-transparent hover:bg-gray-100" data-cal-link="techforce/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"light"}'>Book a Discovery Call</button>
  </div>
</div>
