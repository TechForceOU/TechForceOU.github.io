---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
---

<Layout title="Terms of Service" description="Terms of Service for Tech Force OÜ and techforce.pro">
  <Container>
    <div class="max-w-3xl mx-auto py-16">
      <h1 class="text-4xl font-bold text-slate-800">Terms of Service</h1>
      <p class="text-slate-500 mt-2">Last updated: January 2025</p>

      <div class="mt-10 space-y-8 text-slate-600 leading-relaxed">
        <section>
          <h2 class="text-xl font-semibold text-slate-800">1. About these terms</h2>
          <p class="mt-3">
            These terms govern your use of the techforce.pro website. By accessing this website, you agree to these terms. They apply to the website only — engagement terms for specific projects are covered in separate service agreements.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-800">2. Use of this website</h2>
          <p class="mt-3">
            You may use this website for lawful purposes only. You must not use it in any way that breaches applicable laws, infringes the rights of others, or transmits harmful or misleading content.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-800">3. Intellectual property</h2>
          <p class="mt-3">
            All content on this website — including text, design, and code — is owned by Tech Force OÜ or used under licence. You may not reproduce, distribute, or create derivative works without our written permission.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-800">4. Disclaimer</h2>
          <p class="mt-3">
            This website is provided for informational purposes only. We make no warranties, express or implied, regarding the accuracy or completeness of the content. We are not liable for any loss or damage arising from your use of this website.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-800">5. Links to other websites</h2>
          <p class="mt-3">
            We may link to third-party websites. We do not control and are not responsible for the content or privacy practices of those sites.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-800">6. Governing law</h2>
          <p class="mt-3">
            These terms are governed by the laws of the Republic of Estonia. Any disputes arising from use of this website shall be subject to the jurisdiction of Estonian courts.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-800">7. Contact</h2>
          <p class="mt-3">
            Questions about these terms: <!-- CONTACT_EMAIL -->
          </p>
        </section>
      </div>
    </div>
  </Container>
</Layout>
